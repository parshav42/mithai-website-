# Use the shop's WhatsApp number in international format (digits only, including country code).
NEXT_PUBLIC_SHOP_WHATSAPP_NUMBER=

# Razorpay test-mode placeholders only. Obtain test keys from the shop's Razorpay account.
# The public key ID is intentionally public; never prefix the secret variables with NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PostgreSQL connection. Run `npm run db:migrate` before enabling admin sign-in.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Vercel Blob product image uploads (server-only).
BLOB_READ_WRITE_TOKEN=

# Authenticate the scheduled stock reservation cleanup endpoint.
CRON_SECRET=

# Auth.js. Generate a random AUTH_SECRET for the deployment.
AUTH_SECRET=
ADMIN_EMAIL=
# Generate with `npm run admin:hash-password`; never use a plaintext password here.
ADMIN_PASSWORD_HASH=

# SMS is safely mocked unless SMS_ENABLED=true and MSG91 is fully configured.
SMS_PROVIDER=mock
SMS_ENABLED=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Business configuration (confirm values with the shop owner).
BUSINESS_TIME_ZONE=Asia/Kolkata
SHOP_NAME=
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_GSTIN=
# Set to true only after verifying the shop's invoice/legal details.
SHOP_INVOICE_DETAILS_CONFIRMED=false
